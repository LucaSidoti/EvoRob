<mujoco model="circular_ring_platform">
  <compiler angle="degree" coordinate="local" inertiafromgeom="true" autolimits="true" />
  <option integrator="RK4" timestep="0.001" gravity="0 0 -9.81" />

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
    <rgba haze="0.15 0.25 0.35 1" />
    <global azimuth="120" elevation="-20" />
  </visual>

  <statistic center="0 0 0.3" extent="1.2" />

  <asset>
    <texture name="sky" type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072" />
    <texture name="groundplane" type="2d" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300" />
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2" />
    <material name="platform_mat" rgba="0.3 0.6 0.2 1" reflectance="0.2" shininess="8" />
    <material name="hole_mat" rgba="0 0 0 0" />
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="false" />

    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane" friction="150 150 150" />

    
    <geom name="outer_ring" type="cylinder" pos="0 0 0.4" size="3.0 0.05" material="platform_mat" condim="4" />

    
    <geom name="inner_hole" type="cylinder" pos="0 0 1.0" size="0.5 1.0" material="hole_mat" contype="0" conaffinity="0" group="1" />
  </worldbody>
<include file="AntRobot.xml" /></mujoco>